@model TodoPhoenix.Models.ViewModels.DashboardViewModel
<form id="antiForgeryForm" method="post">
    @Html.AntiForgeryToken()
</form>
<div style="display:flex; gap:40px;">

    <!-- SIDEBAR -->
    <div style="width:250px;">
        <h3>Filters</h3>
        <ul>
            <li><a asp-action="Index" asp-route-filter="All">All Tasks</a></li>
            <li><a asp-action="Index" asp-route-filter="Today">Today</a></li>
            <li><a asp-action="Index" asp-route-filter="Completed">Completed</a></li>
        </ul>

        <h3>Projects</h3>
        <ul>
        @foreach (var project in Model.Projects)
        {
            <li>
                <a asp-action="Index" asp-route-projectId="@project.Id">
                    @project.Name
                </a>

                <button onclick="deleteProject(@project.Id)">
                    X
                </button>
            </li>
        }
        </ul>
        <button onclick="openModal('/Projects/Create')">
            + Add Project
        </button>
    </div>

    <!-- MAIN CONTENT -->
    <div style="flex:1;">
        <h2>Tasks</h2>

        @if (Model.SelectedProjectId != null)
    {
        <button onclick="openModal('/Tasks/Create?projectId=@Model.SelectedProjectId')">
            + Add Task
        </button>
    }

        <ul>
        @foreach (var task in Model.Tasks)
        {
           <li>
                <strong>@task.Title</strong>

                @if (task.DueDate.HasValue)
                {
                    <span> - Due: @task.DueDate.Value.ToString("yyyy-MM-dd")</span>
                }

                <br />

                @if (!string.IsNullOrEmpty(task.Description))
                {
                    <small>
                        @(
                            task.Description.Length > 50
                            ? task.Description.Substring(0, 50) + "..."
                            : task.Description
                        )
                    </small>
                }

                <br />

                (@(task.IsCompleted ? "Done" : "Pending"))

                <button onclick="toggleTask(@task.Id)">Toggle</button>

                <button onclick="openModal('/Tasks/Edit/@task.Id')">
                    Edit
                </button>

                <button onclick="deleteTask(@task.Id)">
                    Delete
                </button>
            </li>
        }
        </ul>
    </div>

</div>

<div id="modalContainer" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5);">
    <div id="modalContent" style="background:white; margin:10% auto; padding:20px; width:400px;">
        <button onclick="closeModal()">Close</button>
        <div id="modalBody"></div>
    </div>
</div>

<script>

function openModal(url) {
    fetch(url)
        .then(res => res.text())
        .then(html => {
            document.getElementById("modalBody").innerHTML = html;
            document.getElementById("modalContainer").style.display = "block";

            attachModalFormHandler(); // 🔥 attach once here
        });
}

function attachModalFormHandler() {
    const form = document.querySelector("#modalBody form");

    if (!form) return;

    form.addEventListener("submit", function (e) {
        e.preventDefault();

        const formData = new FormData(form);

        fetch(form.action, {
            method: form.method,
            body: formData
        })
        .then(res => {
            const contentType = res.headers.get("content-type");

            if (contentType && contentType.includes("application/json")) {
                closeModal();
                location.reload();
                return;
            }

            // ❗ IMPORTANT: after replacing HTML, re-bind again
            return res.text().then(html => {
                document.getElementById("modalBody").innerHTML = html;
                attachModalFormHandler(); // 🔥 THIS LINE FIXES EVERYTHING
            });
        });
    });
}

function closeModal() {
    document.getElementById("modalContainer").style.display = "none";
    document.getElementById("modalBody").innerHTML = "";
}

function toggleTask(id) {
    fetch('/Tasks/ToggleComplete', {
        method: 'POST',
        headers: {
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: new URLSearchParams({ id: id })
    })
    .then(() => location.reload());
}

function deleteTask(id) {
    fetch('/Tasks/Delete', {
        method: 'POST',
        headers: {
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: new URLSearchParams({ id: id })
    })
    .then(() => location.reload());
}
function deleteProject(id) {
    fetch('/Projects/Delete', {
        method: 'POST',
        headers: {
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: new URLSearchParams({ id: id })
    })
    .then(() => {
    window.location.href = "/Dashboard";
});
}
</script>