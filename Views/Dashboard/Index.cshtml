@model TodoPhoenix.Models.ViewModels.DashboardViewModel
<form id="antiForgeryForm" method="post">
    @Html.AntiForgeryToken()
</form>
<div class="row">

    @section Sidebar {
    <h6 class="sidebar-heading">Filters</h6>
    <ul class="list-unstyled mb-4">
        <li>
            <a class="sidebar-link @(Model.CurrentFilter == "All" ? "active" : "")"
            asp-action="Index"
            asp-route-filter="All">
                All Tasks
            </a>
        </li>

        <li>
            <a class="sidebar-link @(Model.CurrentFilter == "Today" ? "active" : "")"
            asp-action="Index"
            asp-route-filter="Today">
                Today
            </a>
        </li>

        <li>
            <a class="sidebar-link @(Model.CurrentFilter == "Completed" ? "active" : "")"
            asp-action="Index"
            asp-route-filter="Completed">
                Completed
            </a>
        </li>
    </ul>

    <h6 class="sidebar-heading">Projects</h6>
    <ul class="list-unstyled mb-3">
        @foreach (var project in Model.Projects)
        {
            <li class="mb-2">
                <div class="d-flex justify-content-between align-items-center">
                <a class="sidebar-link @(Model.SelectedProjectId == project.Id ? "active" : "")"
                        asp-action="Index"
                        asp-route-projectId="@project.Id">
                    @project.Name
                </a>

                <button class="btn btn-sm btn-danger"
                        onclick="deleteProject(@project.Id)">
                    ×
                </button>
        
                </div>
            </li>
        }
    </ul>

    

    <button class="btn btn-primary w-100"
            onclick="openModal('/Projects/Create')">
        + Add Project
    </button>
}
    @{
        var pageTitle = "Tasks";

        if (Model.SelectedProjectId != null)
        {
            pageTitle = Model.Projects
                .FirstOrDefault(p => p.Id == Model.SelectedProjectId)?.Name ?? "Project";
        }
        else if (Model.CurrentFilter == "today")
        {
            pageTitle = "Today's Tasks";
        }
        else if (Model.CurrentFilter == "completed")
        {
            pageTitle = "Completed Tasks";
        }
        else
        {
            pageTitle = "All Tasks";
        }
    }
    <!-- MAIN CONTENT -->
    <div class="main-content">
        <h2>@pageTitle</h2>

        @if (Model.SelectedProjectId != null)
    {
        <button class="btn btn-primary w-100 add-task-btn" onclick="openModal('/Tasks/Create?projectId=@Model.SelectedProjectId')">
            + Add Task
        </button>
    }

        <div class="row">
            @foreach (var task in Model.Tasks)
            {
                <div class="col-md-6 mb-3">
                    <div class="card p-3 task-card @(task.Priority?.ToLower())">

                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-1">@task.Title</h5>

                            @{
                                    var priority = task.Priority?.ToLower();
                                }

                                <span class="badge 
                                    @(priority == "high" ? "bg-danger" :
                                    priority == "medium" ? "bg-warning text-dark" :
                                    "bg-secondary")">
                                    @task.Priority
                                </span>
                        </div>

                        @if (task.DueDate.HasValue)
                        {
                            <small class="due-date">
                                Due: @task.DueDate.Value.ToString("yyyy-MM-dd")
                            </small>
                        }

                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <p class="mt-2">
                                @(task.Description.Length > 50
                                    ? task.Description.Substring(0, 50) + "..."
                                    : task.Description)
                            </p>
                        }

                        <small class="@(task.IsCompleted ? "text-success" : "text-warning")">
                            @(task.IsCompleted ? "Done" : "Pending")
                        </small>

                        <div class="mt-3 d-flex gap-2">
                            <button  type="button" class="btn btn-sm btn-success" onclick="toggleTask(@task.Id)">✔</button>
                            <button  type="button" class="btn btn-sm btn-warning" onclick="openModal('/Tasks/Edit/@task.Id')">Edit</button>
                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteTask(@task.Id)">Delete</button>
                        </div>

                    </div>
                </div>
            }
            </div>
    </div>

</div>
<div id="modalContainer" class="modal-backdrop-custom d-none">
   <div id="modalContent" class="modal-content-custom">
        <button onclick="closeModal()">Close</button>
        <div id="modalBody"></div>
    </div>
</div>

<script>

function openModal(url) {
    fetch(url)
        .then(res => res.text())
        .then(html => {
            document.getElementById("modalBody").innerHTML = html;
            document.getElementById("modalContainer").classList.remove("d-none");

            attachModalFormHandler();
        });
}

function attachModalFormHandler() {
    const form = document.querySelector("#modalBody form");

    if (!form) return;

    form.addEventListener("submit", function (e) {
        e.preventDefault();

        const formData = new FormData(form);

        fetch(form.action, {
            method: form.method,
            body: formData
        })
        .then(res => {
            const contentType = res.headers.get("content-type");

            if (contentType && contentType.includes("application/json")) {
                closeModal();
                location.reload();
                return;
            }

            return res.text().then(html => {
                document.getElementById("modalBody").innerHTML = html;
                attachModalFormHandler(); 
            });
        });
    });
}

function closeModal() {
    document.getElementById("modalContainer").classList.add("d-none");
    document.getElementById("modalBody").innerHTML = "";
}

function toggleTask(id) {
    fetch('/Tasks/ToggleComplete', {
        method: 'POST',
        headers: {
            'RequestVerificationToken': document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value
        },
        body: new URLSearchParams({ id: id })
    })
    .then(() => location.reload());
}

function deleteTask(id) {
    fetch('/Tasks/Delete', {
        method: 'POST',
        headers: {
            'RequestVerificationToken': document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value
        },
        body: new URLSearchParams({ id: id })
    })
    .then(() => location.reload());
}
function deleteProject(id) {
    fetch('/Projects/Delete', {
        method: 'POST',
        headers: {
            'RequestVerificationToken': document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value
        },
        body: new URLSearchParams({ id: id })
    })
    .then(() => {
    window.location.href = "/Dashboard/Index";
});
}
</script>