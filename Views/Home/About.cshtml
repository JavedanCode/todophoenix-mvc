@{
    ViewData["Title"] = "About";
}

<div class="container">
    <div class="card p-4">
        <h2 class="mb-3">About TodoPhoenix</h2>

        <p>
            TodoPhoenix is a task management web application built using
            ASP.NET Core MVC and Entity Framework Core.
        </p>

        <hr />

        <h5>Technologies Used</h5>

        <ul>
            <li>ASP.NET Core MVC</li>
            <li>Entity Framework Core</li>
            <li>SQLite</li>
            <li>Bootstrap 5</li>
            <li>Identity Authentication</li>
        </ul>

        <hr />

        <h5>Features</h5>

        <ul>
            <li>User authentication</li>
            <li>Project management</li>
            <li>Task creation and editing</li>
            <li>Task filtering</li>
            <li>Priority system</li>
            <li>Responsive dashboard</li>
        </ul>
    </div>
</div>